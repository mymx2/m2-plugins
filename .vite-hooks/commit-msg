#!/usr/bin/env sh
set -e

printf '🔍 Checking latest commit message...\n'

# ------------------------------
# ANSI colors (literal escapes, rendered with printf %b)
# ------------------------------
RESET='\033[0m'
RED='\033[31m'
GREEN='\033[32m'
BLUE='\033[34m'
BG_RED='\033[41m'

# ------------------------------
# Get latest commit message
# ------------------------------
MSG_PATH=".git/COMMIT_EDITMSG"

if [ ! -f "$MSG_PATH" ]; then
  printf 'ERROR: commit message file not found: %s\n' "$MSG_PATH"
  exit 1
fi

COMMIT_MSG="$(cat "$MSG_PATH")"
printf '%b\n' "📝 Latest commit message:\n  ${GREEN}${COMMIT_MSG}${RESET}\n"

# ------------------------------
# Commit message pattern
# ------------------------------
COMMIT_MSG_PATTERN='^(revert: )?(feat|fix|refactor|perf|test|infra|deps|docs|chore|wip|release)(\([^)]+\))?: .{1,100}$'

# ------------------------------
# Skip merge or initial commit
# ------------------------------
if printf '%s\n' "$COMMIT_MSG" | grep -Eq '^Merge'; then
  printf '⏭ Skipping merge commit.\n'
  exit 0
fi

if printf '%s\n' "$COMMIT_MSG" | grep -Eq '^Initial commit'; then
  printf '⏭ Skipping initial commit.\n'
  exit 0
fi

if ! printf '%s\n' "$COMMIT_MSG" | grep -Eq "$COMMIT_MSG_PATTERN"; then
  printf '%b\n' "${BG_RED}ERROR${RESET}  ${RED}invalid commit message format.${RESET}\n"
  printf '%b\n' "${RED}Proper commit message format is required for automated changelog generation. Examples:${RESET}\n"
  printf '%b\n' "  ${GREEN}feat(compiler): add 'comments' option${RESET}"
  printf '%b\n' "  ${GREEN}fix(v-model): handle events on blur (close #28)${RESET}\n"
  printf '%b\n' "${RED}Commit message header: <type>(<scope>): <subject>${RESET}"
  printf '%b\n' "${RED}Commit message header pattern: ${COMMIT_MSG_PATTERN}${RESET}"
  printf '%b\n' "${RED}See${RESET} ${BLUE}https://github.com/conventional-commits/conventionalcommits.org${RESET} ${RED}for more details.${RESET}\n"
  printf '%b\n' "${RED}❌ Invalid commit message:${RESET} '${COMMIT_MSG}'"
  exit 1
fi

printf '%b\n' "${GREEN}✅ Latest commit message is valid.${RESET}"
